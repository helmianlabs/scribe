# Copy to .env for local runs (never commit .env). Fly uses `fly secrets` instead.
DATABASE_URL=postgresql://memory_ro:PASSWORD@<NEON_HOST>/claude_memory?sslmode=require
AUTH_PASSPHRASE=choose-a-strong-passphrase
PUBLIC_URL=https://claude-memory-mcp-troy.fly.dev
PORT=8080
DATABASE_WRITE_URL=postgresql://memory_rw:PASSWORD@HOST/claude_memory?sslmode=require
