{
  "name": "claude-memory-mcp-server",
  "version": "2.0.0",
  "description": "Remote MCP server (Streamable HTTP + OAuth 2.1 + DCR) exposing search_memory over Sam's Claude conversation history in Neon.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "stripe": "^17.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
