# Helmian Scribe — SaaS mode environment (SCRIBE_MODE=saas).
# Copy to .env and fill in. Placeholder values only — never commit a filled-in copy.
# Provision the database first: docs/PROVISIONING.md (scripts/provision-saas-db.mjs).

# --- Mode + database -------------------------------------------------------
# Selects the hosted multi-tenant server (the older MEMORY_MODE name also works).
SCRIBE_MODE=saas
# Connection AS the memory_app role (NOSUPERUSER, NOBYPASSRLS) — row-level
# security only binds if the server connects as this role, never as the owner.
# The password is the MEMORY_APP_PASSWORD chosen at provisioning time.
DATABASE_URL=postgres://memory_app:CHANGE-ME@db-host.example:5432/scribe
# SSL is ON by default (Neon and most hosted Postgres require it).
# Set to "disable" ONLY for a local/plain Postgres with no TLS.
# DATABASE_SSL=disable
PORT=8080

# --- Public origin ---------------------------------------------------------
# The exact https origin customers' AI clients connect to. The OAuth issuer,
# the per-tenant resource URLs (/t/<slug>/mcp), cookie Secure flags and Stripe
# redirect URLs ALL derive from this value.
# WARNING: if unset it silently defaults to http://localhost:8080 — a production
# deploy with the wrong PUBLIC_URL mints wrong URLs with no startup error.
PUBLIC_URL=https://scribe.example.com

# --- Sign-in email (magic links) -------------------------------------------
# Real email needs BOTH vars (a verified Resend sending domain). If either is
# missing the server falls back to the DEV mailer: no email is sent, links are
# appended to MAIL_OUTBOX_FILE instead. Boot validation announces that loudly
# in the log — and in production posture it refuses to boot at all.
RESEND_API_KEY=re_CHANGE-ME
MAIL_FROM=Scribe <login@scribe.example.com>
# MAIL_PROVIDER=resend            # auto-detected from the two vars above
MAIL_OUTBOX_FILE=/tmp/smm-mail-outbox.jsonl
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MIN=15

# --- Billing (Stripe, test mode until Sam's go-ahead) ----------------------
# Leave blank to run without billing (checkout disabled). Use TEST keys
# (sk_test_…) — a live key is refused unless STRIPE_ALLOW_LIVE is set, and
# enabling live billing is a deliberate, separate decision.
STRIPE_SECRET_KEY=sk_test_CHANGE-ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE-ME
# Price ids printed by scripts/stripe-create-products.mjs --apply
STRIPE_PRICE_PERSONAL=price_CHANGE-ME
STRIPE_PRICE_PERSONAL_YEARLY=price_CHANGE-ME
STRIPE_PRICE_TEAM=price_CHANGE-ME
# STRIPE_ALLOW_LIVE=yes-i-mean-live

# --- Hosting / boot validation (Docker image + compose: docs/HOSTING.md) ----
# Posture: NODE_ENV=production (set by the SaaS image) or DEPLOY_ENV=production
# turns on production boot validation: PUBLIC_URL must be a real https origin,
# the mailer must be Resend, Stripe must be fully configured or fully off, and
# DATABASE_URL's role must be one RLS can bind — anything else refuses to boot,
# loudly, instead of degrading silently. Leave both unset for local dev.
# NODE_ENV=production
# Provisioning (owner-level; used ONLY by scripts/provision-saas-db.mjs and the
# container entrypoint — the server itself never connects with this):
# PROVISION_DATABASE_URL=postgres://owner:CHANGE-ME@db-host.example:5432/scribe
# MEMORY_APP_PASSWORD=CHANGE-ME          # must match the password in DATABASE_URL
# PROVISION_ON_BOOT=check-only           # entrypoint default; "apply" provisions first
# MIGRATIONS_DIR=/migrations             # set by the SaaS image; only override locally

# --- Optional tuning --------------------------------------------------------
# Per-plan limit overrides, JSON: {"free":{"maxMemories":1000,"maxBytes":52428800,"maxTypedRules":3}}
# PLAN_LIMITS_JSON=
# HMAC secret for outbound Flags alert webhooks (src/flags/alerts.ts).
# ALERT_WEBHOOK_SECRET=CHANGE-ME
# Turns on OpenAI moderation for flagged content (redacted text only).
# OPENAI_API_KEY=
# Extra hosts the Flags scanner treats as safe install sources (comma-separated).
# FLAGS_SAFE_INSTALL_HOSTS=
# Courier owner mailbox (default "sam"; "owner" always reaches it). Set to your
# own name so letters already addressed to you keep arriving.
# SCRIBE_OWNER_MAILBOX=sam
# SCRIBE_OWNER_ALIASES=
