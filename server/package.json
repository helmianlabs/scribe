{
  "name": "helmian-scribe-workspace",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Helmian Scribe workspace: the MCP server plus the Librarian (deterministic rules engine that files every memory).",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dry-run": "tsx scripts/dry-run.ts",
    "build": "esbuild src/server/librarian-store.ts --bundle --platform=node --format=esm --outfile=dist/librarian.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "license": "BUSL-1.1"
}
